{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets.json)",
      "Bash(git push:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)"
    ]
  }
}
